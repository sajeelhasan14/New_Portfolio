# EmailJS — powers the contact form.
#
# These are publishable, browser-side identifiers (that's why they're
# NEXT_PUBLIC_), not secrets: EmailJS expects them to ship to the client, and
# restricts abuse from its dashboard instead. Keeping them in env vars means
# you can point staging and production at different templates without a rebuild.
#
# Find them at https://dashboard.emailjs.com
#   Service ID  → Email Services
#   Template ID → Email Templates  (must expose {{name}}, {{email}}, {{message}})
#   Public key  → Account → General
#
# Copy this file to .env.local and fill in the values.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
